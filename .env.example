# このファイルを .env にコピーして値を埋めてください。
#   cp .env.example .env
# .env は .gitignore 済みです。絶対にコミットしないこと。

# ============ 必須 ============

# セッションCookieの署名鍵。NODE_ENV=production では未設定だと起動しません。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# 承認済みリダイレクトURI に  https://<あなたのドメイン>/auth/google/callback  を登録します。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ログインを許可するメールアドレス（カンマ区切り、* をワイルドカードとして使用可）
# ALLOWED_ADMIN_EMAILS  : アップロード・編集・削除ができる管理者
# ALLOWED_VIEWER_EMAILS : 再生のみ。空にすると「管理者以外は全員 viewer」になります。
ALLOWED_ADMIN_EMAILS=you@example.com
ALLOWED_VIEWER_EMAILS=*@example.com

# ============ 任意（未設定なら該当機能がスキップされます） ============

# 自動文字起こし (https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=

# 文字起こし結果の日本語整形 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 利用時間制限（JST, HH:MM-HH:MM）。日をまたぐ指定 22:00-06:00 も可。
# 未設定なら常時利用可能。
ALLOWED_TIME_RANGE=
RESTRICTED_MESSAGE=現在はシステム利用時間外です。

# ============ 上級者向け ============

# 待ち受けポート（既定 3001）
# PORT=3001

# 音声・DB・文字起こしの保存先（既定: リポジトリの2階層上の data/、Docker では /data）
# DATA_DIR=/data
